# API credentials for model providers.
# Copy this file to `.env` and fill in only the providers you use.
# The framework loads these via the environment; it never writes keys to run logs.

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
# Optional: point at a gateway / Azure / local OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# DeepSeek (OpenAI-compatible; used by `deepseek-flash` for cheap shakedown runs)
# Secret is never written to run logs.
DEEPSEEK_API_KEY=

# Groq (OpenAI-compatible free tier; used by `groq-gpt-oss-120b` for shakedowns)
GROQ_API_KEY=

# Google (Gemini)
GEMINI_API_KEY=
# or, depending on the SDK/account: GOOGLE_API_KEY=
