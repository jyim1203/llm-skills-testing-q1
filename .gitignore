# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.venv-harness/
.venv-data/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Secrets and local configuration
.env
*.local.toml

# Experiment outputs (regenerated on every run)
runs/
!runs/.gitkeep

# Raw benchmark downloads (not needed once instances are cached). The cached
# per-instance definitions under data/instances/ ARE committed so a run is
# reproducible byte-for-byte; they are small (~100 KB total for the subset).
data/raw/

# Derived behavior tables (regenerated from immutable Harbor job artifacts)
data/derived/

# Runtime launcher logs/status for the mechanism runs
data/mechanism-pilot-01/logs/
data/mechanism-pilot-01/run_status.jsonl
data/mechanism-pilot-01/run.out
data/mechanism-pilot-01/run.err
data/mechanism-pilot-01/resume-*
