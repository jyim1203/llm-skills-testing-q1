# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.venv-harness/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Secrets and local configuration
.env
*.local.toml

# Experiment outputs (regenerated on every run)
runs/
!runs/.gitkeep

# Raw benchmark downloads (not needed once instances are cached). The cached
# per-instance definitions under data/instances/ ARE committed so a run is
# reproducible byte-for-byte; they are small (~100 KB total for the subset).
data/raw/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS noise
.DS_Store
Thumbs.db
desktop.ini
